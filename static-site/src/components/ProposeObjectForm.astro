---
interface Props {
  tops: string[];
}
const { tops } = Astro.props;
---

<section class="propose">
  <h2>Propose a new object</h2>
  <p id="propose-object-signed-out" class="muted">
    <a href="#auth-widget">Sign in</a> to propose a new object.
  </p>

  <form id="propose-object-form" hidden>
    <label>
      category
      <select id="po-top" required>
        {tops.map((top) => <option value={top}>{top}</option>)}
      </select>
    </label>
    <label>
      subcategory <span class="muted">(optional)</span>
      <input id="po-sub" type="text" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="e.g. able" />
    </label>
    <label>
      name
      <input id="po-name" type="text" required minlength="1" />
    </label>
    <label>
      slug <span class="muted">(url-friendly id, auto-filled from name)</span>
      <input id="po-slug" type="text" required pattern="[a-z0-9]+(-[a-z0-9]+)*" />
    </label>
    <label>
      description <span class="muted">(optional)</span>
      <textarea id="po-description" rows="2"></textarea>
    </label>
    <label>
      topics <span class="muted">(optional, comma-separated)</span>
      <input id="po-topics" type="text" placeholder="e.g. language, speaking" />
    </label>
    <label>
      url <span class="muted">(optional)</span>
      <input id="po-url" type="url" placeholder="https://…" />
    </label>
    <label>
      url label <span class="muted">(required if url given)</span>
      <input id="po-url-label" type="text" />
    </label>
    <button type="submit">submit proposal</button>
    <p id="propose-object-success" class="success" hidden>
      Thanks! Your proposal is pending review.
    </p>
    <p id="propose-object-error" class="error" hidden></p>
  </form>
</section>

<script>
  import { onAuth, submitObjectProposal } from "../lib/firebase";

  const signedOutMsg = document.getElementById("propose-object-signed-out")!;
  const form = document.getElementById("propose-object-form") as HTMLFormElement;
  const successEl = document.getElementById("propose-object-success")!;
  const errorEl = document.getElementById("propose-object-error")!;

  const nameInput = document.getElementById("po-name") as HTMLInputElement;
  const slugInput = document.getElementById("po-slug") as HTMLInputElement;
  const topSelect = document.getElementById("po-top") as HTMLSelectElement;
  const subInput = document.getElementById("po-sub") as HTMLInputElement;
  const descInput = document.getElementById("po-description") as HTMLTextAreaElement;
  const topicsInput = document.getElementById("po-topics") as HTMLInputElement;
  const urlInput = document.getElementById("po-url") as HTMLInputElement;
  const urlLabelInput = document.getElementById("po-url-label") as HTMLInputElement;

  let slugTouched = false;
  slugInput.addEventListener("input", () => (slugTouched = true));
  function slugify(s: string): string {
    return s
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }
  nameInput.addEventListener("input", () => {
    if (!slugTouched) slugInput.value = slugify(nameInput.value);
  });

  onAuth((user) => {
    signedOutMsg.hidden = !!user;
    form.hidden = !user;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successEl.hidden = true;
    errorEl.hidden = true;

    const url = urlInput.value.trim();
    const urlLabel = urlLabelInput.value.trim();
    if (url && !urlLabel) {
      errorEl.textContent = "url label is required when a url is given";
      errorEl.hidden = false;
      return;
    }

    const topics = topicsInput.value
      .split(",")
      .map((t) => t.trim())
      .filter(Boolean);

    try {
      await submitObjectProposal({
        top: topSelect.value,
        sub: subInput.value.trim() || undefined,
        slug: slugInput.value.trim(),
        name: nameInput.value.trim(),
        description: descInput.value.trim() || undefined,
        topics: topics.length > 0 ? topics : undefined,
        url: url || undefined,
        urlLabel: url ? urlLabel : undefined,
      });
      form.reset();
      slugTouched = false;
      successEl.hidden = false;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message.replace(/^Firebase:\s*/, "") : String(err);
      errorEl.hidden = false;
    }
  });
</script>
