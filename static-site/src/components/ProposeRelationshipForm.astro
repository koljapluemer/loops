---
interface Props {
  sourceId: string;
  sourceName: string;
  entries: { id: string; name: string }[];
}
const { sourceId, sourceName, entries } = Astro.props;
const options = entries.filter((e) => e.id !== sourceId);
---

<section class="propose">
  <h2>Propose a relationship</h2>
  <p id="propose-rel-signed-out" class="muted">
    <a href="#auth-widget">Sign in</a> to propose a relationship for this object.
  </p>

  <form id="propose-rel-form" hidden>
    <label>
      related object
      <select id="pr-target" required>
        <option value="" disabled selected>choose an object…</option>
        {options.map((e) => <option value={e.id}>{e.name} ({e.id})</option>)}
      </select>
    </label>
    <label>
      context <span class="muted">(a short grouping name, e.g. "misc")</span>
      <input id="pr-context" type="text" required minlength="1" placeholder="misc" />
    </label>
    <label>
      relationship description
      <input id="pr-label" type="text" required minlength="1" placeholder="e.g. practice singing" />
    </label>
    <button type="submit">submit proposal</button>
    <p id="propose-rel-success" class="success" hidden>
      Thanks! Your proposal is pending review.
    </p>
    <p id="propose-rel-error" class="error" hidden></p>
  </form>
</section>

<script define:vars={{ sourceId, sourceName }}>
  window.__proposeRelSource = { sourceId, sourceName };
</script>
<script>
  import { onAuth, submitRelationshipProposal } from "../lib/firebase";

  const { sourceId, sourceName } = (window as any).__proposeRelSource as {
    sourceId: string;
    sourceName: string;
  };

  const signedOutMsg = document.getElementById("propose-rel-signed-out")!;
  const form = document.getElementById("propose-rel-form") as HTMLFormElement;
  const successEl = document.getElementById("propose-rel-success")!;
  const errorEl = document.getElementById("propose-rel-error")!;

  const targetSelect = document.getElementById("pr-target") as HTMLSelectElement;
  const contextInput = document.getElementById("pr-context") as HTMLInputElement;
  const labelInput = document.getElementById("pr-label") as HTMLInputElement;

  onAuth((user) => {
    signedOutMsg.hidden = !!user;
    form.hidden = !user;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successEl.hidden = true;
    errorEl.hidden = true;

    const targetOption = targetSelect.selectedOptions[0];
    if (!targetOption || !targetOption.value) {
      errorEl.textContent = "choose a related object";
      errorEl.hidden = false;
      return;
    }

    try {
      await submitRelationshipProposal({
        sourceId,
        sourceName,
        targetId: targetOption.value,
        targetName: targetOption.textContent ?? targetOption.value,
        context: contextInput.value.trim(),
        label: labelInput.value.trim(),
      });
      form.reset();
      successEl.hidden = false;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message.replace(/^Firebase:\s*/, "") : String(err);
      errorEl.hidden = false;
    }
  });
</script>
