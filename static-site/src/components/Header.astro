---
import { UserRound, LogIn } from "@lucide/astro";
import AuthModal from "./AuthModal.astro";
---

<header class="navbar bg-base-200 border-b border-base-300 px-3 min-h-0 py-2">
  <div class="flex-1">
    <a href="/" class="font-bold text-lg">the platform</a>
  </div>
  <div class="flex-none">
    <button
      id="header-signed-out"
      type="button"
      class="btn btn-sm btn-primary"
      hidden
    >
      <LogIn class="size-4" /> sign in / up
    </button>
    <a id="header-signed-in" href="/profile/" class="btn btn-sm btn-ghost" hidden>
      <UserRound class="size-4" /> profile
    </a>
  </div>
</header>

<AuthModal />

<script>
  import { onAuth } from "../lib/firebase";

  const signedOutBtn = document.getElementById("header-signed-out")!;
  const signedInLink = document.getElementById("header-signed-in")!;

  signedOutBtn.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-auth-modal"));
  });

  onAuth((user) => {
    signedOutBtn.hidden = !!user;
    signedInLink.hidden = !user;
  });
</script>
