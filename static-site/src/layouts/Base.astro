---
import AuthWidget from "../components/AuthWidget.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · The Platform</title>
  </head>
  <body>
    <header class="site-header">
      <AuthWidget />
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      body {
        max-width: 40rem;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        color: #1a1a1a;
      }
      h1 {
        text-transform: capitalize;
      }
      h2 {
        font-size: 1.1rem;
        margin-top: 2rem;
      }
      ul {
        padding-left: 1.2rem;
      }
      .muted {
        color: #666;
        font-size: 0.9rem;
      }
      .tags {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      .tags li {
        background: #eee;
        border-radius: 1rem;
        padding: 0.1rem 0.7rem;
        font-size: 0.85rem;
      }
      .entry-img {
        max-width: 100%;
        border-radius: 0.3rem;
      }
      a {
        color: #0055aa;
      }
      .site-header {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }
      .auth-widget,
      .auth-form {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      .auth-widget input {
        width: 9rem;
      }
      .propose {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
      }
      .propose form {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        max-width: 28rem;
      }
      .propose label {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-size: 0.9rem;
      }
      .propose input,
      .propose select,
      .propose textarea {
        font: inherit;
        padding: 0.3rem 0.4rem;
      }
      .propose button {
        align-self: flex-start;
        padding: 0.3rem 0.9rem;
      }
      .error {
        color: #b00020;
      }
      .success {
        color: #0a7a2f;
      }
    </style>
  </body>
</html>
