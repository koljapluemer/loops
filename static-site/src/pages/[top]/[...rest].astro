---
import Base from "../../layouts/Base.astro";
import RelationModal from "../../components/RelationModal.astro";
import {
  getAllEntries,
  getEntry,
  getBacklinks,
  getContexts,
  getTopLevels,
  getSecondaryTypes,
  getAllContextNames,
  idToHref,
  imgSrc,
  textList,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllEntries().map((entry) => ({
    params: {
      top: entry.top,
      rest: entry.segments.slice(1).join("/"),
    },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = getEntry(id)!;
const backlinks = getBacklinks(id);
const description = textList(entry.raw.description).join(" / ");
const topics = textList(entry.raw.topics);
const contexts = getContexts(entry);
const allEntries = getAllEntries().map((e) => ({ id: e.id, name: e.name }));

const tops = getTopLevels();
const secondaryTypesByTop = Object.fromEntries(tops.map((t) => [t, getSecondaryTypes(t)]));
const contextNames = getAllContextNames();
---

<Base title={entry.name}>
  <p class="mb-2"><a href={`/${entry.top}/`} class="link link-hover text-sm">&larr; {entry.top}</a></p>

  <div class="flex items-start gap-3 mb-1">
    {
      entry.raw.img && (
        <img
          class="w-16 h-16 object-contain rounded border border-base-300 bg-base-100 shrink-0"
          src={imgSrc(entry.raw.img)}
          alt={entry.name}
        />
      )
    }
    <div>
      <h1 class="text-2xl font-bold leading-tight">{entry.name}</h1>
      {
        entry.altNames.length > 0 && (
          <p class="text-sm text-base-content/60">also known as: {entry.altNames.join(", ")}</p>
        )
      }
    </div>
  </div>

  {description && <p class="text-sm mb-2">{description}</p>}

  {
    topics.length > 0 && (
      <ul class="flex flex-wrap gap-1 mb-3">
        {topics.map((t) => (
          <li class="badge badge-sm badge-ghost">{t}</li>
        ))}
      </ul>
    )
  }

  {
    entry.raw.urls && entry.raw.urls.length > 0 && (
      <section class="mb-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-1">Links</h2>
        <ul class="flex flex-col gap-0.5">
          {entry.raw.urls.map((u) => (
            <li>
              <a href={u[0]} target="_blank" rel="noopener noreferrer" class="link link-hover text-sm">
                {u[1]}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mb-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-1">Relations</h2>
    {contexts.length === 0 && <p class="text-sm text-base-content/60">No relations yet.</p>}
    <div class="flex flex-col gap-3">
      {
        contexts.map((c) => (
          <div class="border border-base-300 rounded p-2">
            <h3 class="font-medium text-sm mb-1">{c.name}</h3>
            <ul class="flex flex-col gap-0.5 mb-1">
              {c.rels.map((r) => (
                <li class="text-sm">
                  {r.target ? (
                    <a href={idToHref(r.targetId)} class="link link-hover">
                      {r.target.name}
                    </a>
                  ) : (
                    <span class="text-base-content/50">{r.targetId}</span>
                  )}
                  {r.label && <> — {r.label}</>}
                </li>
              ))}
            </ul>
            <ul class="my-rel-proposals flex flex-col gap-1 mb-1 empty:hidden" data-context={c.name} />
            <div class="auth-gate" hidden>
              <RelationModal
                id={`rel-${entry.id.replace(/[:]/g, "-")}-${c.name}`}
                sourceId={entry.id}
                sourceName={entry.name}
                context={c.name}
                entries={allEntries}
                tops={tops}
                secondaryTypesByTop={secondaryTypesByTop}
                contextNames={contextNames}
                triggerLabel="+ propose relationship"
              />
            </div>
          </div>
        ))
      }
    </div>

    <ul id="my-rel-proposals-unmatched" class="flex flex-col gap-1 mt-2 empty:hidden"></ul>

    <div class="auth-gate mt-3" hidden>
      <RelationModal
        id={`ctx-${entry.id.replace(/[:]/g, "-")}`}
        sourceId={entry.id}
        sourceName={entry.name}
        entries={allEntries}
        tops={tops}
        secondaryTypesByTop={secondaryTypesByTop}
        contextNames={contextNames}
        triggerLabel="+ propose additional context"
        triggerClass="btn btn-xs btn-outline btn-primary"
      />
    </div>
    <p class="auth-gate-hint text-xs text-base-content/50 mt-2" hidden>
      <button
        type="button"
        class="link link-primary"
        onclick="document.dispatchEvent(new CustomEvent('open-auth-modal'))"
      >
        Sign in
      </button> to propose contexts or relationships.
    </p>
  </section>

  {
    backlinks.length > 0 && (
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60 mb-1">Backlinks</h2>
        <ul class="flex flex-col gap-0.5">
          {backlinks.map((b) => (
            <li class="text-sm">
              <a href={idToHref(b.from.id)} class="link link-hover">
                {b.from.name}
              </a>
              {b.label && <> — {b.label}</>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script is:inline define:vars={{ sourceId: entry.id }}>
  window.__nodePageSourceId = sourceId;
</script>
<script>
  import { onAuth } from "../../lib/firebase";
  import { initRelationForms } from "../../lib/relationForms";
  import { mountMyRelationshipProposalsGrouped } from "../../lib/myProposals";

  initRelationForms();

  const sourceId = (window as any).__nodePageSourceId as string;

  onAuth((user) => {
    document.querySelectorAll<HTMLElement>(".auth-gate").forEach((el) => (el.hidden = !user));
    document.querySelectorAll<HTMLElement>(".auth-gate-hint").forEach((el) => (el.hidden = !!user));
  });

  // Route each of "my" pending relationship proposals into the matching
  // context block (by name), falling back to a bucket below the section
  // when the proposed context doesn't match any context shown above (i.e.
  // it's itself a newly proposed context).
  const contextContainers = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>(".my-rel-proposals").forEach((c) => {
    contextContainers.set(c.dataset.context!, c);
  });
  const unmatched = document.getElementById("my-rel-proposals-unmatched")!;

  mountMyRelationshipProposalsGrouped(sourceId, contextContainers, unmatched);
</script>
