---
import Base from "../../layouts/Base.astro";
import { getSecondaryTypes } from "../../lib/data";

const secondaryTypes = getSecondaryTypes("learn");
---

<Base title="Propose a learning node">
  <p class="mb-2"><a href="/" class="link link-hover text-sm">&larr; home</a></p>
  <h1 class="text-2xl font-bold mb-4">propose a learning node</h1>

  <p id="propose-signed-out" class="text-sm text-base-content/70">
    <button
      type="button"
      class="link link-primary"
      onclick="document.dispatchEvent(new CustomEvent('open-auth-modal'))"
    >
      Sign in
    </button> to propose a new learning node.
  </p>

  <form id="propose-form" class="flex flex-col gap-3 max-w-sm" hidden>
    <label class="form-control">
      <span class="label-text text-sm mb-1">type</span>
      <select id="pn-sub" class="select select-bordered select-sm" required>
        {secondaryTypes.map((sub) => <option value={sub}>{sub}</option>)}
      </select>
    </label>
    <label class="form-control">
      <span class="label-text text-sm mb-1">name</span>
      <input id="pn-name" type="text" class="input input-bordered input-sm" required minlength="1" />
    </label>
    <button type="submit" class="btn btn-primary btn-sm self-start">submit proposal</button>
    <p id="propose-success" class="text-success text-sm" hidden>
      Thanks! Your proposal is pending review.
    </p>
    <p id="propose-error" class="text-error text-sm" hidden></p>
  </form>
</Base>

<script>
  import { onAuth, submitObjectProposal } from "../../lib/firebase";

  const signedOutMsg = document.getElementById("propose-signed-out")!;
  const form = document.getElementById("propose-form") as HTMLFormElement;
  const successEl = document.getElementById("propose-success")!;
  const errorEl = document.getElementById("propose-error")!;
  const subSelect = document.getElementById("pn-sub") as HTMLSelectElement;
  const nameInput = document.getElementById("pn-name") as HTMLInputElement;

  function slugify(s: string): string {
    return s
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  onAuth((user) => {
    signedOutMsg.hidden = !!user;
    form.hidden = !user;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successEl.hidden = true;
    errorEl.hidden = true;

    const slug = slugify(nameInput.value);
    if (!slug) {
      errorEl.textContent = "please enter a name";
      errorEl.hidden = false;
      return;
    }

    try {
      await submitObjectProposal({
        top: "learn",
        sub: subSelect.value,
        slug,
        name: nameInput.value.trim(),
      });
      form.reset();
      successEl.hidden = false;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message.replace(/^Firebase:\s*/, "") : String(err);
      errorEl.hidden = false;
    }
  });
</script>
