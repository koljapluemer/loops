---
import Base from "../layouts/Base.astro";
---

<Base title="Profile">
  <h1 class="text-2xl font-bold mb-4">profile</h1>

  <p id="profile-signed-out" class="text-sm text-base-content/70" hidden>
    <button
      type="button"
      class="link link-primary"
      onclick="document.dispatchEvent(new CustomEvent('open-auth-modal'))"
    >
      Sign in
    </button> to see your profile.
  </p>

  <div id="profile-signed-in" class="flex flex-col gap-3 max-w-sm" hidden>
    <p class="text-sm">
      signed in as <span id="profile-email" class="font-medium"></span>
    </p>
    <div class="flex gap-2">
      <button type="button" id="profile-sign-out" class="btn btn-sm btn-outline">sign out</button>
      <button type="button" id="profile-delete" class="btn btn-sm btn-error btn-outline">
        delete account
      </button>
    </div>
    <p id="profile-error" class="text-error text-sm" hidden></p>
  </div>
</Base>

<script>
  import { onAuth, signOutUser, deleteAccount } from "../lib/firebase";

  const signedOutMsg = document.getElementById("profile-signed-out")!;
  const signedInBox = document.getElementById("profile-signed-in")!;
  const emailEl = document.getElementById("profile-email")!;
  const errorEl = document.getElementById("profile-error")!;

  function showError(err: unknown) {
    const message = err instanceof Error ? err.message : String(err);
    errorEl.textContent = message.replace(/^Firebase:\s*/, "");
    errorEl.hidden = false;
  }

  onAuth((user) => {
    signedOutMsg.hidden = !!user;
    signedInBox.hidden = !user;
    if (user) emailEl.textContent = user.email ?? "";
  });

  document.getElementById("profile-sign-out")!.addEventListener("click", async () => {
    errorEl.hidden = true;
    try {
      await signOutUser();
      window.location.href = "/";
    } catch (err) {
      showError(err);
    }
  });

  document.getElementById("profile-delete")!.addEventListener("click", async () => {
    errorEl.hidden = true;
    if (!confirm("Delete your account? This cannot be undone.")) return;
    try {
      await deleteAccount();
      window.location.href = "/";
    } catch (err: any) {
      if (err?.code === "auth/requires-recent-login") {
        const password = prompt("Please re-enter your password to confirm account deletion:");
        if (!password) return;
        try {
          await deleteAccount(password);
          window.location.href = "/";
        } catch (err2) {
          showError(err2);
        }
      } else {
        showError(err);
      }
    }
  });
</script>
