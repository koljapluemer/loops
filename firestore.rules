rules_version = '2';

// Deploy these in the Firebase console (Firestore Database → Rules) or via
// `firebase deploy --only firestore:rules`. See FIREBASE_SETUP.md.
//
// Model: signed-in users may create their own "proposals" (pending review),
// and may read back only the proposals they submitted. Nobody can update or
// delete a proposal from the client — the local-cms tool moves proposals to
// accepted/rejected/deferred using the Firebase Admin SDK, which is not
// subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /proposals/{proposalId} {
      allow read: if request.auth != null
        && resource.data.submittedByUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['object', 'relationship'];

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
